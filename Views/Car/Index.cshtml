@model List<Car> 
@{
    ViewData["Title"] = "Available Cars";
}
<h2 class="mb-4">Available Cars</h2>

<p class="mb-4">Here are the cars currently available for rent:</p>


@if (Model==null || Model.Count == 0 )
{
    <div class="alert alert-info">
        No cars are currently available for rent.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var car in Model)
        {
           <div class="col">
                <div class="card">
                    <div class="card-body p-4">

                        <h5 class="card-title">
                            @car.Name
                        </h5>

                        <p class="card-text">
                            <strong>PKR @car.PricePerDay</strong>
                            <span class="badge bg-success">
                                Available
                            </span>
                        </p>

                        <form asp-controller="Car"
                              asp-action="Book"
                              method="post"
                              class="mt-3">

                            <input type="hidden"
                                   name="carId"
                                   value="@car.Id" />

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Book Car
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
}

